#!/usr/bin/env bash
# forge — Forge startup wrapper
# Usage: ./forge serve
# Serves the repo over HTTP for fetch-dependent pages (Forge Sheet, .dc.html bundles).

set -e
cd "$(dirname "$0")"

COMMAND="${1:-serve}"

if [[ "$COMMAND" == "serve" ]]; then
  # The sheet composes editor links (vscode://file/…) from repo-relative
  # paths in state.json; it learns the repo root from this gitignored file.
  mkdir -p sheet/state
  printf '{ "root": "%s" }\n' "$(pwd)" > sheet/state/serve-root.json
  echo "==> Starting server at http://localhost:8080/sheet/"
  echo "    Press Ctrl+C to stop."
  echo ""
  python3 -m http.server 8080
else
  echo "Usage: ./forge serve"
  exit 1
fi
